{
  "name": "ravelry-mcp",
  "version": "2.8.0",
  "description": "MCP server for searching and exploring knitting and crochet patterns on Ravelry",
  "license": "MIT",
  "author": "Gpaul | Faldin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpaul-mcp/MCP_ravelry.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ravelry",
    "knitting",
    "crochet"
  ],
  "type": "module",
  "bin": {
    "ravelry-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npm run build && npx @modelcontextprotocol/inspector node --env-file-if-exists=.env dist/index.js",
    "check": "npm run typecheck && npm run lint && npm test",
    "pack:mcpb": "npm run build && node scripts/pack-mcpb.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run check && npm run build",
    "smoke": "node scripts/smoke.ts",
    "dev:ui": "vite build --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "oidc-provider": "^9.12.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/node": "^24.19.1",
    "@types/oidc-provider": "^9.12.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "lint-staged": {
    "*.{ts,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": "prettier --write"
  }
}
