# Read-only API credentials from https://www.ravelry.com/pro/developer
# (create an app with "basic auth" access; these are NOT your Ravelry login).
RAVELRY_USERNAME=
RAVELRY_PASSWORD=

# Optional
# RAVELRY_TIMEOUT_MS=15000

# ---- Self-hosting (HTTP mode, see docs/self-hosting.md) ----
# MCP_TRANSPORT=http                # stdio (default) or http
# HOST=127.0.0.1
# PORT=3000
# MCP_ALLOWED_HOSTS=ravelry.example.com    # public hostname(s), comma-separated
# MCP_URL_SECRET=                   # endpoint becomes /mcp/<secret>; 16+ chars [A-Za-z0-9_-]
# RATE_LIMIT_PER_MINUTE=60          # per client; 0 disables
# TRUST_PROXY=false                 # true behind Cloudflare Tunnel / a reverse proxy
# CLOUDFLARE_TUNNEL_TOKEN=          # only for `docker compose --profile tunnel`
